---
import "../styles/global.css";
import { Image } from "astro:assets";
import agplIcon from "../assets/agplv3_icon.png";
import edbpedeIcon from "../assets/edbpede.svg";
import githubIcon from "../assets/github_icon.webp";
import ConverterForm from "../components/ConverterForm.svelte";
import LanguageSwitcher from "../components/LanguageSwitcher.svelte";
import { defaultLang, getTranslations } from "../i18n/utils";

// The document is server-rendered in the default language, and the islands apply
// the persisted `language` store once they hydrate. A visitor who chose English
// therefore reads a Danish page until hydration completes and then sees the text
// swap under them — never an untranslated key, but not instant either.
//
// That window is real and it got longer in the move to islands: measured against
// the pre-migration inline script (~6.5 KB of JS) versus these islands (~55 KB,
// Svelte runtime included), the flip goes from ~100 ms to ~180 ms on a fast
// connection and from ~1.1 s to ~2.9 s at 400 kbps. It is the honest price of
// deleting the imperative getElementById sweep this page used to run.
//
// Closing it properly means serving the chosen language from the server; a
// blocking inline script in <head> would only reintroduce the imperative code
// this migration removed.
const translations = getTranslations(defaultLang);
---

<!DOCTYPE html>
<html lang={defaultLang}>
  <head>
    <meta charset="utf-8">
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="generator" content={Astro.generator}>
    <meta name="description" content={translations.app.description}>
    <meta name="theme-color" content="#ef4444">
    {/*			Dark mode is the operating system's and nothing else: there is no theme
			toggle and no `.dark` class on this page. uno.config.ts sets
			`presetWind4({ dark: "media" })` so every `dark:` utility compiles to a
			`prefers-color-scheme` query that this declaration opts the page into.*/}
    <meta name="color-scheme" content="light dark">
    <title>{translations.app.title}</title>
  </head>
  <body
    class="min-h-screen bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-900 dark:to-slate-800"
  >
    <!-- Language Switcher -->
    <LanguageSwitcher client:load />

    <!-- Main Content -->
    <main class="flex items-center justify-center min-h-screen px-4 py-12">
      <div class="w-full max-w-2xl">
        {/*					client:load, not client:visible: this is the whole page, above the
					fold, and it is the only thing the visitor came here to use.*/}
        <ConverterForm client:load>
          {/*						Rendered by Astro rather than by the island, because `<Image>` is a
						build-time component: it emits the optimised `/_astro/…` asset and
						its intrinsic dimensions. Astro hands the result to the island as a
						snippet, so the markup below is exactly what ships.*/}
          <Fragment slot="footerLinks">
            <div class="flex items-center justify-center gap-4 mt-6">
              <a
                href="https://edb.fi"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 bg-white dark:bg-slate-400 rounded-lg shadow-sm transition-all duration-200 hover:scale-105 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                aria-label="Visit edb.fi"
              >
                <Image
                  src={edbpedeIcon}
                  alt="edbpede logo"
                  width={32}
                  height={32}
                  class="w-8 h-8"
                />
              </a>
              <a
                href="https://github.com/edbfi/yt-redirect"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 bg-white dark:bg-slate-400 rounded-lg shadow-sm transition-all duration-200 hover:scale-105 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                aria-label="View GitHub repository"
              >
                <Image src={githubIcon} alt="GitHub" width={32} height={32} class="w-8 h-8" />
              </a>
              <a
                href="https://www.gnu.org/licenses/agpl-3.0.en.html"
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 bg-white dark:bg-slate-400 rounded-lg shadow-sm transition-all duration-200 hover:scale-105 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-red-500 focus:ring-offset-2 dark:focus:ring-offset-slate-900"
                aria-label="AGPL v3 License"
              >
                {/*									height is 24, not 32, so that 72x24 matches the source's own
									3.04 aspect ratio (agplv3_icon.png is 155x51). Astro 5 ignored
									the mismatched height and emitted 72x24 anyway; Astro 7 honours
									both dimensions and would emit a cropped, vertically stretched
									72x32 badge instead. The rendered size is unchanged either way
									-- `w-16 h-8` sizes the box at 64x32 -- so this keeps the footer
									pixel-identical to the pre-migration build.*/}
                <Image src={agplIcon} alt="AGPL v3" width={72} height={24} class="w-16 h-8" />
              </a>
            </div>
          </Fragment>
        </ConverterForm>
      </div>
    </main>
  </body>
</html>
