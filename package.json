{
  "name": "yt-redirect",
  "type": "module",
  "version": "1.0.0",
  "description": "A modern YouTube link converter that converts YouTube URLs to yout-ube.com equivalents",
  "license": "AGPL-3.0-or-later",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "check": "bunx --bun astro check && bunx --bun svelte-check --tsconfig ./tsconfig.json && bun run check:native",
    "check:native": "bunx --bun svelte-check --tsgo --tsconfig ./tsconfig.json",
    "test": "bun test",
    "test:e2e": "bunx --bun playwright test",
    "lint": "bunx --bun biome check .",
    "lint:fix": "bunx --bun biome check --write ."
  },
  "dependencies": {
    "@nanostores/persistent": "1.3.5",
    "astro": "7.3.3",
    "nanostores": "1.5.3",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/bun": "1.4.2",
    "@unocss/astro": "66.10.5",
    "@unocss/reset": "66.10.5",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "unocss": "66.10.5"
  },
  "keywords": [
    "youtube",
    "converter",
    "astro",
    "svelte",
    "unocss",
    "i18n"
  ],
  "author": ""
}
